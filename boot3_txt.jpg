window.__P=[["C02_scam", "11/15/2026", ["C02_scam_v2_slide1.jpg", "C02_scam_v2_slide2.jpg", "C02_scam_v2_slide3.jpg", "C02_scam_v2_slide4.jpg", "C02_scam_v2_slide5.jpg"], "6 red flags before you send a single dollar to Japan. 🚩\n\nJapan’s embassy in Tanzania and Zambia’s government have both warned buyers about fake online car exporters. Here’s how to spot one before it costs you.\n\n📌 Save this and send it to whoever is buying a car this year.\n\n💬 Comment SAFE for my full pre-payment checklist.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #carscam"], ["R01_5checks", "11/16/2026", ["R01_5checks_v2.mp4"], "Before you send a single dollar to Japan, run these 5 checks. 🔒\n\nJapan’s embassy in Tanzania has warned buyers about fake exporters. These checks take 10 minutes and can save your money.\n\n📌 Save this for the day you buy.\n💬 Comment SAFE for the full checklist.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #carscam"], ["R02_buyerside", "11/17/2026", ["R02_buyerside_v2.mp4"], "I spent 10+ years on the seller’s side of Japanese car export. Now I work for you, the buyer. 🤝\n\nHonest breakdowns, real landed prices to Dar es Salaam and Lusaka, and checks before you pay.\n\n💬 Comment START with your country and budget.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["C03_grades", "11/18/2026", ["C03_grades_v2_slide1.jpg", "C03_grades_v2_slide2.jpg", "C03_grades_v2_slide3.jpg", "C03_grades_v2_slide4.jpg", "C03_grades_v2_slide5.jpg"], "Grade 4.5 sounds great. But do you know what it actually means? 🔍\n\nSwipe for a plain-English guide to Japanese auction grades, including the letters that mean a car has been repaired.\n\n💬 Comment GRADE and send me any auction sheet. I’ll read it for you, free.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #auctionsheet"], ["R03_sheetcodes", "11/19/2026", ["R03_sheetcodes_v2.mp4"], "Grade 4.5 doesn’t mean perfect. The truth is on the damage map. 🔍\n\nA = scratch, U = dent, W = wave (repair), S = rust, X = needs replacing. The number shows the size.\n\n💬 Comment SHEET and send me any auction sheet. I’ll read it for you, free.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #auctionsheet"], ["R04_taxband", "11/20/2026", ["R04_taxband_v2.mp4"], "Tanzania now taxes used cars by age, and most buyers find out at the port. 🇹🇿\n\nSince 1 July 2026: 18% at 8–10 years, 35% at 10–20, 40% over 20.\n\n💬 Comment TAX with your model and year and I’ll tell you the band. (Confirm final figures with TRA or your clearing agent.)\n\n#magaritanzania #carsfortanzania #daressalaam #japanesecars #importfromjapan"], ["C04_landed", "11/21/2026", ["C04_landed_v2_slide1.jpg", "C04_landed_v2_slide2.jpg", "C04_landed_v2_slide3.jpg", "C04_landed_v2_slide4.jpg", "C04_landed_v2_slide5.jpg"], "That “cheap” car price you saw online? It’s not what you’ll pay. 💰\n\nSwipe for every cost between Japan and your driveway: FOB, freight, insurance, duty, excise, VAT, clearing and (for Zambia) the border and inland trip.\n\n💬 Comment PRICE with the model and your city for a full breakdown.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["R05_pov_account", "11/23/2026", ["R05_pov_account_v2.mp4"], "If the bank account is in a personal name, stop right there. 🚫\n\nReal Japanese exporters are paid into a company account in Japan, matching the invoice name exactly.\n\n💬 Comment SAFE for my full pre-payment checklist.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #carscam"], ["R06_zambia_route", "11/24/2026", ["R06_zambia_route_v2.mp4"], "Zambia is landlocked, so your car’s journey doesn’t end at the port. 🇿🇲\n\nJapan → Dar es Salaam or Durban → border → Lusaka. Make sure your quote covers every leg.\n\n💬 Comment LUSAKA with the car you want for a full landed price.\n\n#carsforsalezambia #lusaka #zambia #japanesecars #importfromjapan"], ["C05_odometer", "11/25/2026", ["C05_odometer_v2_slide1.jpg", "C05_odometer_v2_slide2.jpg", "C05_odometer_v2_slide3.jpg", "C05_odometer_v2_slide4.jpg"], "Low mileage sells cars. That’s exactly why it gets faked. ⚠️\n\n4 simple checks to catch odometer fraud before you buy, from matching documents to reading the wear.\n\n💬 Comment KM and send me a car’s photos. I’ll tell you if the story adds up.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #carscam"], ["R07_bl_check", "11/26/2026", ["R07_bl_check_v2.mp4"], "A fake Bill of Lading is one of the oldest tricks in car export. 🚢\n\nVerify it yourself: find the shipping line, go to their official site, track the B/L number and match the chassis.\n\n💬 Comment BL and I’ll help you check one.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #carscam"], ["R08_after_pay", "11/27/2026", ["R08_after_pay_v2.mp4"], "From payment to driving: the 5 stages of importing a car from Japan. 🛳️\n\nKnowing each step means you know exactly what to ask for, and when.\n\n💬 Comment PROCESS for my step-by-step guide.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["C06_models", "11/28/2026", ["C06_models_v2_slide1.jpg", "C06_models_v2_slide2.jpg", "C06_models_v2_slide3.jpg", "C06_models_v2_slide4.jpg"], "Why do Vitz, Allion, RAV4, Hilux and Hiace fill the roads in Tanzania and Zambia? 🚗\n\nThey’re reliable, parts are easy to find, and every mechanic knows them. Swipe for which one fits city life, family or business.\n\n💬 Comment MODEL with your budget and city for real options.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #toyota"], ["R09_cheap_fob", "11/30/2026", ["R09_cheap_fob_v2.mp4"], "Cheap in Japan doesn’t mean cheap in Dar or Lusaka. 💸\n\nGrade, age and engine size all change what you really pay. Compare landed prices, not FOB prices.\n\n💬 Comment PRICE with the model for a full breakdown.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["R10_hiace", "12/01/2026", ["R10_hiace_v2.mp4"], "A Hiace can be the best business decision you make, or the worst. 🚐\n\n5 checks before you buy one for passenger or cargo work.\n\n💬 Comment HIACE with your budget and city.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #toyotahiace"], ["C07_docs", "12/02/2026", ["C07_docs_v2_slide1.jpg", "C07_docs_v2_slide2.jpg", "C07_docs_v2_slide3.jpg", "C07_docs_v2_slide4.jpg", "C07_docs_v2_slide5.jpg"], "7 documents you should receive when you import a car from Japan. 📄\n\nIf an exporter can’t show you these, stop and ask why. Swipe through and save it for later.\n\n💬 Comment DOCS if you’re missing one and I’ll tell you what to ask for.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["R11_quiz_W", "12/03/2026", ["R11_quiz_W_v2.mp4"], "Quick quiz: what does “W” mean on a Japanese auction sheet? 🤔\n\nDrop your answer before the reveal 👇 Then comment SHEET if you want me to read a sheet for you, free.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #auctionsheet"], ["C08_decide", "12/05/2026", ["C08_decide_v2_slide1.jpg", "C08_decide_v2_slide2.jpg", "C08_decide_v2_slide3.jpg", "C08_decide_v2_slide4.jpg"], "Thinking of importing a car from Japan? Decide these 5 things before you message anyone. ✅\n\nYou’ll get clearer quotes, avoid surprises and spot bad offers faster.\n\n💬 Comment START with your country and budget.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["R12_3questions", "12/07/2026", ["R12_3questions_v2.mp4"], "Ask these 3 questions before you wire a single dollar. ❓\n\nA real exporter will answer all of them without hesitation.\n\n💬 Comment SAFE for my full checklist.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan #carscam"], ["R13_auction_vs_stock", "12/08/2026", ["R13_auction_vs_stock_v2.mp4"], "Should you buy from a Japanese auction or from dealer stock? ⚖️\n\nBoth can be great. It depends on your time, budget and how specific you are about the car.\n\n💬 Comment ASK and tell me what you’re looking for.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["C09_tzzm", "12/09/2026", ["C09_tzzm_v2_slide1.jpg", "C09_tzzm_v2_slide2.jpg", "C09_tzzm_v2_slide3.jpg", "C09_tzzm_v2_slide4.jpg"], "Importing to Tanzania vs Zambia: what actually changes? 🇹🇿🇿🇲\n\nThe route, the border, and the tax rules. Swipe for a quick side-by-side.\n\n💬 Comment COMPARE with a model and I’ll show both landed prices.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["R14_myths", "12/11/2026", ["R14_myths_v2.mp4"], "4 myths about Japanese used cars that cost buyers real money. ❌\n\nWhich one did you believe? Tell me in the comments 👇\n\n💬 Comment ASK with any question about importing.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"], ["C10_roadmap", "12/12/2026", ["C10_roadmap_v2_slide1.jpg", "C10_roadmap_v2_slide2.jpg", "C10_roadmap_v2_slide3.jpg", "C10_roadmap_v2_slide4.jpg", "C10_roadmap_v2_slide5.jpg"], "Your complete roadmap for importing a car from Japan, in 8 steps. 🗺️\n\nPlan → Protect → Receive. Save it, and share it with someone who’s buying soon.\n\n💬 Comment START with your country and budget.\n\n#carsfortanzania #carsforsalezambia #japanesecars #importfromjapan"]];

window.__H='05', window.__M='30', window.__AP='PM';
window.__patch=()=>{ if(window.__patchedV2) return; const ifr=document.createElement('iframe'); ifr.style.display='none'; document.body.appendChild(ifr); const nc=ifr.contentWindow.HTMLInputElement.prototype.click; HTMLInputElement.prototype.click=function(){ if(this.type==='file'&&window.__pendingFiles){ const dt=new DataTransfer(); window.__pendingFiles.forEach(f=>dt.items.add(f)); this.files=dt.files; this.dispatchEvent(new Event('input',{bubbles:true})); this.dispatchEvent(new Event('change',{bubbles:true})); window.__pendingFiles=null; return;} return nc.apply(this,arguments); }; window.__patchedV2=true; if(!window.__lsn){ window.addEventListener('message',e=>{ if(e.origin!=='https://raw.githack.com') return; if(e.data&&e.data.tveReady) window.__ready=true; if(e.data&&e.data.tveFiles) e.data.tveFiles.forEach(f=>{ if(f instanceof File) window.__recv[f.name]=f; }); }); window.__lsn=true; } };
window.__fetchFiles=async(FILES)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); window.__recv={}; let fr=document.getElementById('tvehelper'); if(!fr){ window.__ready=false; fr=document.createElement('iframe'); fr.id='tvehelper'; fr.style.display='none'; fr.src='https://raw.githack.com/ehsanbaber-eb/tve-instagram-media/main/helper.html'; document.body.appendChild(fr);} for(let k=0;k<50&&!window.__ready;k++) await sleep(300); fr.contentWindow.postMessage({want:FILES},'https://raw.githack.com'); for(let k=0;k<80&&FILES.some(n=>!window.__recv[n]);k++) await sleep(500); return FILES.every(n=>window.__recv[n]); };
window.__btn=(t)=>[...document.querySelectorAll('[role=button]')].find(e=>e.innerText&&e.innerText.trim()===t);
window.__setRow=async(idx,DATE)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); const d=document.querySelectorAll('input[placeholder="mm/dd/yyyy"]')[idx]; const setter=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set; d.focus(); setter.call(d,DATE); d.dispatchEvent(new Event('input',{bubbles:true})); d.dispatchEvent(new Event('change',{bubbles:true})); await sleep(300); d.dispatchEvent(new KeyboardEvent('keydown',{key:'Enter',code:'Enter',keyCode:13,which:13,bubbles:true})); await sleep(200); d.blur(); d.dispatchEvent(new FocusEvent('focusout',{bubbles:true})); await sleep(400);
 const arrow=(el,up)=>el.dispatchEvent(new KeyboardEvent('keydown',{key:up?'ArrowUp':'ArrowDown',code:up?'ArrowUp':'ArrowDown',keyCode:up?38:40,which:up?38:40,bubbles:true,cancelable:true})); const txt=el=>(el.parentElement.innerText||'').trim();
 const spin=async(el,target)=>{ el.focus(); for(let i=0;i<70&&txt(el)!==target;i++){ const cur=parseInt(txt(el),10); arrow(el,isNaN(cur)?true:cur<parseInt(target,10)); await sleep(60);} };
 const h=document.querySelectorAll('input[aria-label=hours]')[idx], m=document.querySelectorAll('input[aria-label=minutes]')[idx], ap=document.querySelectorAll('input[aria-label=meridiem]')[idx];
 await spin(h,window.__H); await spin(m,window.__M); ap.focus(); for(let i=0;i<3&&txt(ap)!==window.__AP;i++){ arrow(ap,true); await sleep(150);} ap.blur(); await sleep(300);
 return {date:d.value,t:[h,m,ap].map(txt).join(' ')}; };
window.__want=(D)=>new Date(D).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'});
window.__okRows=(a,b,D)=>a.date===window.__want(D)&&b.date===window.__want(D)&&a.t===window.__H+' '+window.__M+' '+window.__AP&&b.t===a.t;
window.__carStart=async(i)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); for(let k=0;k<40&&!window.__btn('Add photo/video');k++) await sleep(500); window.__patch(); const P=window.__P[i]; if(!await window.__fetchFiles(P[2])) return 'FAIL files'; window.__pendingFiles=P[2].map(n=>window.__recv[n]); window.__btn('Add photo/video').click(); return P[0]+' attaching '+P[2].length; };
window.__carPrep=async(i)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); const P=window.__P[i]; const cnt=()=>(document.body.innerText.match(/\b\d{3,4} [x×] \d{3,4}\b/g)||[]).length; for(let k=0;k<20&&(cnt()<P[2].length||/Uploading media/.test(document.body.innerText));k++) await sleep(1000); if(cnt()!==P[2].length) return 'MEDIA '+cnt(); const el=document.querySelector('[contenteditable=true][role=combobox]'); el.focus(); const dt=new DataTransfer(); dt.setData('text/plain',P[3]); el.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true})); await sleep(800); const sw=document.querySelector('input[aria-label="Set date and time"]'); if(sw&&!sw.checked){ sw.click(); await sleep(1200);} const a=await window.__setRow(0,P[1]); const b=await window.__setRow(1,P[1]); return P[0]+' cap='+el.innerText.slice(0,20)+' '+JSON.stringify({a,b,ok:window.__okRows(a,b,P[1])}); };
window.__carDone=async(i)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); const P=window.__P[i]; const ds=[...document.querySelectorAll('input[placeholder="mm/dd/yyyy"]')].map(x=>x.value); const t=[...document.querySelectorAll('input[aria-label=hours],input[aria-label=minutes],input[aria-label=meridiem]')].map(x=>(x.parentElement.innerText||'').trim()).join(' '); const T=window.__H+' '+window.__M+' '+window.__AP; if(!(ds.length===2&&ds.every(d=>d===window.__want(P[1]))&&t===T+' '+T)) return 'CHECK FAIL '+JSON.stringify({ds,t}); [...document.querySelectorAll('[role=button],button')].find(b=>b.innerText.trim()==='Schedule').click(); for(let k=0;k<30;k++){ await sleep(1000); if(/Your post is scheduled/.test([...document.querySelectorAll('[role=dialog]')].map(x=>x.innerText).join(' '))) return P[0]+' SCHEDULED'; } return P[0]+' TIMEOUT'; };
window.__reelStart=async(i)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); for(let k=0;k<40&&!window.__btn('Add Video');k++) await sleep(500); window.__patch(); const P=window.__P[i]; if(!await window.__fetchFiles(P[2])) return 'FAIL file'; window.__pendingFiles=[window.__recv[P[2][0]]]; window.__btn('Add Video').click(); for(let k=0;k<25&&!(document.body.innerText.includes(P[2][0])&&/\n100%/.test(document.body.innerText));k++) await sleep(1000); if(!document.body.innerText.includes(P[2][0])) return 'NOT ATTACHED'; const el=document.querySelector('[contenteditable=true]'); el.focus(); const dt=new DataTransfer(); dt.setData('text/plain',P[3]); el.dispatchEvent(new ClipboardEvent('paste',{clipboardData:dt,bubbles:true,cancelable:true})); await sleep(800); return P[0]+' cap='+el.innerText.slice(0,20); };
window.__reelShare=async()=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); for(let k=0;k<8&&!/Scheduling options/.test(document.body.innerText);k++){ const n=[...document.querySelectorAll('[role=button]')].reverse().find(b=>b.innerText.trim()==='Next'); if(n) n.click(); await sleep(2500);} for(let k=0;k<5&&!document.querySelectorAll('input[placeholder="mm/dd/yyyy"]').length;k++){ const seg=[...document.querySelectorAll('[role=button],button,[role=tab],[role=radio],div')].find(b=>b.children.length<=2&&b.innerText&&b.innerText.trim()==='Schedule'&&b.getBoundingClientRect().top<400); if(seg) seg.click(); await sleep(1500);} return document.querySelectorAll('input[placeholder="mm/dd/yyyy"]').length; };
window.__reelSched=async(i)=>{ const sleep=ms=>new Promise(r=>setTimeout(r,ms)); const P=window.__P[i]; const a=await window.__setRow(0,P[1]); const b=await window.__setRow(1,P[1]); if(!window.__okRows(a,b,P[1])) return 'CHECK FAIL '+JSON.stringify({a,b}); const bs=[...document.querySelectorAll('[role=button]')].filter(x=>x.innerText.trim()==='Schedule'); bs[bs.length-1].click(); for(let k=0;k<20;k++){ await sleep(1000); if(/Reel scheduled/.test([...document.querySelectorAll('[role=dialog]')].map(x=>x.innerText).join(' '))) return P[0]+' SCHEDULED'; } return P[0]+' TIMEOUT'; };

